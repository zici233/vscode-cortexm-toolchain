# ============================================================
#  ARM Cortex-M 交叉编译工具链文件（CMake 用）
#  由 tasks.json 中的 -DCMAKE_TOOLCHAIN_FILE=toolchain.cmake 引入
#  占位符需替换为实际值：
#    __ARM_GCC_BIN__ -> arm-none-eabi bin 目录绝对路径
# ============================================================

set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

set(TOOLCHAIN_PREFIX __ARM_GCC_BIN__/arm-none-eabi-)

set(CMAKE_C_COMPILER   ${TOOLCHAIN_PREFIX}gcc)
set(CMAKE_CXX_COMPILER ${TOOLCHAIN_PREFIX}g++)
set(CMAKE_ASM_COMPILER ${TOOLCHAIN_PREFIX}gcc)
set(CMAKE_OBJCOPY      ${TOOLCHAIN_PREFIX}objcopy CACHE FILEPATH "" FORCE)
set(CMAKE_SIZE         ${TOOLCHAIN_PREFIX}size    CACHE FILEPATH "" FORCE)

# 交叉编译时禁用编译器探测的 try-compile
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
