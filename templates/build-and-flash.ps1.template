# PowerShell 5.1-compatible build and flash helper.
# Replace the placeholders before copying this file to build-and-flash.ps1.
$ErrorActionPreference = 'Stop'

cmake --build --preset debug
if ($LASTEXITCODE -ne 0) {
    exit $LASTEXITCODE
}

openocd -f "__INTERFACE_CFG__" -f "__TARGET_CFG__" -c "program __FIRMWARE__ verify reset exit"
exit $LASTEXITCODE
