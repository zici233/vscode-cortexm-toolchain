
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure (cmake)",
      "type": "shell",
      "command": "__CMAKE__",
      "args": [
        "--fresh",
        "--preset", "debug"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "build (cmake)",
      "type": "shell",
      "command": "__CMAKE__",
      "args": ["--build", "--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "dependsOn": ["configure (cmake)"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "flash (openocd)",
      "type": "shell",
      "command": "__OPENOCD__",
      "args": [
        "-s", "__OPENOCD_SCRIPTS__",
        "-f", "__INTERFACE_CFG__",
        "-f", "__TARGET_CFG__",
        "-c", "program __FIRMWARE__ verify reset exit"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["build (cmake)"],
      "problemMatcher": []
    }
  ]
}
