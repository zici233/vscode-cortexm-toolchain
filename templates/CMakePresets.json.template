// ============================================================
//  CMake Presets 模板（配合 CMakeLists.txt 使用）
//  生成时去掉 .template 后缀，并替换占位符：
//    __NINJA__      -> ninja.exe 绝对路径（使用正斜杠）
//    __BUILD_TYPE__ -> Debug / Release（默认 Debug）
//  生成时删除所有 // 注释行，输出严格 JSON；本 skill 使用 --fresh，要求 CMake 3.24+。
// ============================================================
{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "__BUILD_TYPE__",
        "CMAKE_MAKE_PROGRAM": "__NINJA__"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    }
  ]
}
